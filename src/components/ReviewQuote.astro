---
import { reviews, type ReviewId } from '../data/reviews';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  id: ReviewId;
  lang: Lang;
  size?: 'lg' | 'md' | 'sm';
  class?: string;
}

const { id, lang, size = 'md', class: className } = Astro.props;
const r = reviews[id];
const t = ui[lang];
const translated = r.lang !== lang;
// The translation label names the language translated *from*.
const translationLabel = lang === 'en' ? ui.en.translation : ui.es.translation;
---

<figure class:list={['quote', `quote--${size}`, className]} data-reveal>
  <svg class="quote__mark" viewBox="0 0 48 36" aria-hidden="true" focusable="false">
    <path
      d="M0 36V22C0 9 7 1.5 19 0l2 5.4C13.6 7.5 10.4 12 10.4 18H19v18H0Zm27 0V22c0-13 7-20.5 19-22l2 5.4C40.6 7.5 37.4 12 37.4 18H46v18H27Z"
      fill="currentColor"></path>
  </svg>
  <blockquote lang={r.lang}>
    <p>{r.text}</p>
  </blockquote>
  {
    translated && (
      <p class="quote__translation" lang={lang}>
        <span class="quote__label">{translationLabel}:</span> {r.translation}
      </p>
    )
  }
  <figcaption>
    <span class="quote__stars" aria-hidden="true">★★★★★</span>
    <span class="quote__name">{r.name}</span>
    <span class="quote__source">{t.googleReview}</span>
  </figcaption>
</figure>

<style>
  .quote {
    position: relative;
    margin: 0;
  }

  .quote__mark {
    width: 2.6rem;
    height: auto;
    margin-bottom: 1rem;
    color: var(--gold);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 420;
    line-height: 1.3;
    font-variation-settings: 'SOFT' 80;
  }

  .quote--lg blockquote {
    font-size: var(--step-3);
    letter-spacing: -0.015em;
  }

  .quote--md blockquote {
    font-size: var(--step-1);
  }

  .quote--sm blockquote {
    font-size: var(--step-0);
    line-height: 1.45;
  }

  .quote__translation {
    margin-top: 1rem;
    font-size: var(--step--1);
    line-height: 1.55;
    opacity: 0.85;
  }

  .quote__label {
    font-weight: 700;
    font-style: normal;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-top: 1.25rem;
  }

  .quote__stars {
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  .quote__name {
    font-weight: 700;
  }

  .quote__source {
    font-size: var(--step--1);
    opacity: 0.75;
  }
</style>
